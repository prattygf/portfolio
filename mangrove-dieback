S2 = S2.filterBounds(ctb);

function maskClouds(image) {
    var cloudProb = image.select('MSK_CLDPRB');
    var scl = image.select('SCL');
    var valid = scl.gte(2).and(scl.lte(7));
    var mask = cloudProb.eq(0).and(valid);
    image = image.updateMask(mask);
    return image;
};
function calcNDVI(image) {
  var ndvi = image.normalizedDifference(["B8", "B4"]);
  ndvi = ndvi.set("system:time_start", image.get("system:time_start"));
  return ndvi;
};



S2 = S2.map(maskClouds);
var ndviImages = S2.map(calcNDVI);

var chart = ui.Chart.image.seriesByRegion({
